# Dipakai docker-compose.yml di folder ini. Salin: cp .env.example .env
# Panduan lengkap: DEPLOY_VPS.md

# ---------- URL publik (pakai domain + HTTPS; kamera eKYC WAJIB HTTPS) ----------
PUBLIC_API_ORIGIN=https://api.domainkamu.com
PUBLIC_FRONTEND_URL=https://app.domainkamu.com
PUBLIC_CMS_URL=https://cms.domainkamu.com
# 127.0.0.1 = hanya lewat Nginx di VPS (disarankan). 0.0.0.0 = buka port langsung (tes via IP).
BIND_IP=127.0.0.1

# ---------- Secret (generate SEKALI, jangan diubah setelah jalan) ----------
# APP_KEY  : echo "base64:$(openssl rand -base64 32)"
# JWT_SECRET / EKYC_AI_API_KEY : openssl rand -hex 32
APP_KEY=
JWT_SECRET=
EKYC_AI_API_KEY=
DB_PASSWORD=ganti-password-db
# Nama project compose & database (versi Danapathi: danapathi). Ganti SEBELUM `up` pertama —
# mengganti setelah jalan = volume/DB baru (data lama tidak ikut).
COMPOSE_PROJECT_NAME=victoria
DB_NAME=victoria
DB_USER=victoria

# ---------- Brand ----------
# Versi Danapathi: clone repo api/frontend/cms dengan `-b danapathi` (lihat DEPLOY_VPS.md)
APP_NAME="Victoria Sekuritas API"
MAIL_FROM_NAME="Victoria Sekuritas"
# APP_NAME="Danapathi API"
# MAIL_FROM_NAME="Danapathi Asset Management"

# ---------- Password akun demo (repo PUBLIK → jangan pakai default di server) ----------
# Kosong = default (Admin@123456 / Ops@123456 / Member@123). Berlaku saat seed pertama / migrate:fresh --seed.
DEMO_ADMIN_PASSWORD=
DEMO_OPS_PASSWORD=
DEMO_MEMBER_PASSWORD=

# ---------- Email aktivasi akun ----------
# log = link aktivasi hanya di log server. Untuk demo ke klien, pakai SMTP
# (mis. Brevo gratis 300 email/hari, atau Gmail + App Password).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domainkamu.com

# ---------- eKYC ----------
# fastapi = AI asli (butuh RAM ≥ 8 GB, model ±3 GB). stub = tanpa AI (OCR tidak auto-isi form).
EKYC_PROVIDER=fastapi
EKYC_WITH_MODELS=true
OCR_ENGINE=nanonets
FACE_MATCH_ENGINE=insightface
LIVENESS_ENGINE=facenox-onnx
SELFIE_KTP_ENGINE=nanonets_tesseract
NANONETS_N_THREADS=4
# Mode A hemat RAM (server ±4 GB available): model Q3_K_M + konteks 4096 + InsightFace kecil
# NANONETS_MODEL_FILE=Nanonets-OCR-s-Q3_K_M.gguf
# NANONETS_CTX_SIZE=4096
# INSIGHTFACE_MODEL_NAME=buffalo_s
# AI di mesin lain (laptop via ngrok): isi URL-nya, lalu jalankan tanpa service ekyc-ai
# EKYC_FASTAPI_URL=https://xxxx.ngrok-free.app
EKYC_FASTAPI_TIMEOUT=180

# ---------- Integrasi pihak ketiga (demo = mock) ----------
PAYMENT_GATEWAY=mock
SINVEST_DRIVER=mock

# Port host (ubah bila bentrok dengan proses lain di VPS)
API_PORT=8080
WEB_PORT=3000
CMS_PORT=3001
