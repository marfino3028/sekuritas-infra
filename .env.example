# Dipakai oleh docker-compose.yml di folder ini saat build frontend & cms
# (keduanya SPA statis, jadi URL API di-bake ke dalam file JS saat `docker compose build`).
#
# Ganti localhost dengan IP publik atau domain VPS Anda, contoh:
#   PUBLIC_API_URL=http://203.0.113.10:8080/api
#   PUBLIC_CMS_API_URL=http://203.0.113.10:8080/api/cms
#   PUBLIC_FRONTEND_URL=http://203.0.113.10:3000
#
# Kalau sudah pakai domain + Nginx reverse proxy + HTTPS, pakai itu:
#   PUBLIC_API_URL=https://api.namadomainanda.com/api
#   PUBLIC_CMS_API_URL=https://api.namadomainanda.com/api/cms
#   PUBLIC_FRONTEND_URL=https://namadomainanda.com

PUBLIC_API_URL=http://localhost:8080/api
PUBLIC_CMS_API_URL=http://localhost:8080/api/cms
PUBLIC_FRONTEND_URL=http://localhost:3000
